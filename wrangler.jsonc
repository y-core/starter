{
  "send_metrics": false,
  "name": "forge-starter",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-14",
  "dev": {
    "ip": "0.0.0.0",
    "port": 8787,
    "local_protocol": "http"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
