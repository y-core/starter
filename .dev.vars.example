# Copy to .dev.vars; wrangler dev merges wrangler.jsonc vars + (.dev.vars wins).
################################################################################
# DEV CONFIG OVERRIDES - Never commit; it contains secrets
################################################################################
BASE_URL=http://localhost:8787

# Set to DEBUG to show error details in 500 responses. Omit in prod — defaults to off.
LOG_LEVEL=DEBUG

# EMAIL_FROM and EMAIL_TO can be defined here to override defaults from src/config/app.ts

################################################################################
# SECRETS - Never place secrets in wrangler.jsonc.
# Production: Cloudflare dashboard (Settings → Variables and Secrets, encrypted).
################################################################################
# CSRF protection — generate with: openssl rand -hex 32
CSRF_SECRET=your-64-char-hex-csrf-secret

EMAIL_API_KEY=dev-placeholder-api-key

# Cloudflare Turnstile — create a site at dash.cloudflare.com/turnstile.
# "Always passes" test site key — overrides prod key for local dev:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
