{
  "name": "forge-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "forge-assets build all --minify --root . --config src/assets/config.ts --out .forge/assets.ts",
    "dev": "bun run build:assets && wrangler dev src/worker.dev.ts --live-reload",
    "fix": "forge-verify --fix",
    "lint": "forge-verify --only lint",
    "test": "bun test tests/",
    "types:assets": "forge-verify --only types:assets",
    "verify": "forge-verify"
  },
  "dependencies": {
    "@y-core/forge": "https://codeload.github.com/y-core/forge/tar.gz/refs/tags/v0.0.86"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@tailwindcss/cli": "^4.3.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.1",
    "urlpattern-polyfill": "^10.1.0",
    "wrangler": "^4.105.0"
  },
  "overrides": {
    "ws": "^8.20.1"
  }
}
