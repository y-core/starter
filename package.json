{
  "name": "forge-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "bun run node_modules/@y-core/forge/src/assets/cli/bin.ts build all --minify --config src/assets/config.ts --out .forge/assets.ts",
    "cf:typecheck": "wrangler types ./.types/cloudflare.d.ts --no-include-env && wrangler types ./.types/worker-configuration.d.ts --no-include-runtime",
    "check": "bun run cf:typecheck && tsgo --noEmit && bun run lint && bun test tests/",
    "dev": "bun run build:assets && (tailwindcss -i src/assets/tailwind.css -o public/assets/css/main.css --watch & wrangler dev src/worker.dev.ts --live-reload)",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "test": "bun test tests/"
  },
  "dependencies": {
    "@y-core/forge": "github:y-core/forge#v0.0.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/cli": "^4.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260602.1",
    "esbuild": "^0.28.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "wrangler": "^4.96.0"
  },
  "overrides": {
    "ws": "^8.20.1"
  }
}
