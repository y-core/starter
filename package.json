{
  "name": "forge-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "bun run node_modules/@y-core/forge/src/assets/cli/mod.ts build all --minify --config src/assets/config.ts --out .forge/assets.manifest.json",
    "cf:typecheck": "wrangler types ./.types/cloudflare.d.ts --no-include-env && wrangler types ./.types/worker-configuration.d.ts --no-include-runtime",
    "check": "bun run typecheck && bun run lint && bun test tests/",
    "dev": "bun run build:assets && (tailwindcss -i src/assets/tailwind.css -o public/assets/css/main.css --watch & wrangler dev src/worker.dev.ts --config wrangler.jsonc --live-reload)",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "test": "bun test tests/",
    "typecheck": "bun run cf:typecheck && tsgo --noEmit"
  },
  "dependencies": {
    "@y-core/forge": "github:y-core/forge#v0.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/cli": "^4.1.8",
    "@typescript/native-preview": "^7.0.0-dev.20260517.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.8",
    "wrangler": "^4.93.0"
  },
  "overrides": {
    "ws": "^8.20.1"
  }
}
