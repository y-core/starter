.DS_Store

.codex
.claude/scheduled_tasks.lock

.dev.vars
.env
.env*
.forge/
.wrangler/

# Generated by `wrangler types` on every `verify`, so tracking them means a permanently dirty tree —
# and `worker-configuration.d.ts` enumerates whatever `.dev.vars` holds, which is this application's
# whole secret inventory. `secrets.required` in wrangler.jsonc is the declared source instead.
.types/cloudflare.d.ts
.types/worker-configuration.d.ts

bin/
coverage/
node_modules/
playwright-report/
test-results/
public/
tmp/

*.test
*.out

# Agent-sandbox placeholders, not project files.
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.gitmodules
.ripgreprc
.idea
.vscode
.claude/hooks
.claude/launch.json
.claude/routines
.claude/scheduled_tasks.json
.claude/settings.json
# Local skills stay untracked, but warden's synced one is tracked exactly as `.claude/agents/` is:
# the drift step fails on a missing file, so an ignored sync target is a red gate on a fresh clone.
# `/*` rather than the bare directory, because git does not reconsider a negation inside an
# excluded directory.
.claude/skills/*
!.claude/skills/warden-review/
.claude/workflows
